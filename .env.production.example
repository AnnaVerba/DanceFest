# Every variable below (except the image ones) is a GitHub Actions secret of
# the same name. The deploy job writes them to .env next to
# docker-compose.prod.yml on the instance. Never commit real values.

# ---------------------------------------------------------------------------
# GitHub Actions secrets (Settings → Secrets and variables → Actions).
# The deploy job reads these from GitHub, NOT from this file — they are
# listed here so the whole setup lives in one place.
#
# DEPLOY_HOST=203.0.113.10          # instance IP or hostname
# DEPLOY_USER=deploy_master         # SSH user in the docker group
# DEPLOY_SSH_KEY=                   # private key (whole file, incl. BEGIN/END lines)
# DEPLOY_PORT=22                    # optional, defaults to 22
# DEPLOY_PATH=dansefest             # optional, relative to the user's home
#
# GITHUB_TOKEN is provided by Actions automatically (GHCR push/pull).
# ---------------------------------------------------------------------------

# Images (set by the deploy job; lower-case owner/repo)
BACKEND_IMAGE=ghcr.io/annaverba/dansefest-backend
FRONTEND_IMAGE=ghcr.io/annaverba/dansefest-frontend
IMAGE_TAG=latest
HTTP_PORT=80

# Database
DB_USERNAME=dansefest
DB_PASSWORD=
DB_NAME=dansefest

# Auth — long random strings, different from each other.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Public address of the site (invitation links, CORS), e.g. http://203.0.113.10
FRONTEND_URL=

# First admin, created on boot if no user with this email exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# SMS one-time codes: dev | twilio | turbosms
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
