# Every variable below (except the image ones) is a GitHub Actions secret of
# the same name. The deploy job writes them to .env next to
# docker-compose.prod.yml on the instance. Never commit real values.

# ---------------------------------------------------------------------------
# GitHub Actions secrets (Settings → Secrets and variables → Actions).
# The deploy job reads these from GitHub, NOT from this file — they are
# listed here so the whole setup lives in one place.
#
# DEPLOY_HOST=203.0.113.10          # instance IP or hostname
# DEPLOY_USER=deploy_master         # SSH user in the docker group
# DEPLOY_SSH_KEY=                   # private key (whole file, incl. BEGIN/END lines)
# DEPLOY_PORT=22                    # optional, defaults to 22
# DEPLOY_PATH=dansefest             # optional, relative to the user's home
#
# GITHUB_TOKEN is provided by Actions automatically (GHCR push/pull).
# ---------------------------------------------------------------------------

# Images (set by the deploy job; lower-case owner/repo)
BACKEND_IMAGE=ghcr.io/annaverba/dansefest-backend
FRONTEND_IMAGE=ghcr.io/annaverba/dansefest-frontend
IMAGE_TAG=latest
HTTP_PORT=80

# ===========================================================================
# REQUIRED — the deploy job stops before touching the instance if any is empty.
# ===========================================================================

# Database
DB_PASSWORD=

# Auth — long random strings, different from each other.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis (music-export job queue). The username must not be "default".
REDIS_USERNAME=dansefest
REDIS_PASSWORD=

# ===========================================================================
# OPTIONAL — the backend starts without them; the related feature stays off
# (or the value shown here is used by the deploy job) until the secret is added.
# ===========================================================================

DB_USERNAME=dansefest
DB_NAME=dansefest
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Public address of the site (invitation links, CORS), e.g. http://203.0.113.10
FRONTEND_URL=

# First admin, created on boot if no user with this phone exists
# (both needed; only matters on an empty database).
ADMIN_PHONE=
ADMIN_PASSWORD=

# Mail — without these, emails are only logged.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin

# OneCloudPlanet S3 storage — without the keys, banner/track uploads and the
# music export answer "storage not configured".
OCP_ACCESS_KEY_ID=
OCP_SECRET_ACCESS_KEY=
OCP_REGION=ua-central-1
OCP_BUCKET=project-bucket-dance-fest
OCP_ENDPOINT=https://s3.ua-central-1.ocplanet.cloud
OCP_PUBLIC_URL=
OCP_IMAGES_PREFIX=images
OCP_AUDIO_PREFIX=audio

# SMS one-time codes: dev | twilio | turbosms
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
