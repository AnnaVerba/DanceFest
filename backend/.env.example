PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=Dance-Fest-Local

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

FRONTEND_URL=http://localhost:5173

# First admin, seeded on boot if no user with this phone exists
ADMIN_PHONE=
ADMIN_PASSWORD=

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin

# OneCloudPlanet (OCP) S3-compatible Object Storage — see console.ocplanet.cloud
# Used for competition banners and entry tracks (see backend/src/tracks).
OCP_REGION=us-east-1
OCP_ACCESS_KEY_ID=
OCP_SECRET_ACCESS_KEY=
OCP_BUCKET=
OCP_PUBLIC_URL=
OCP_ENDPOINT=https://s3.ua-central-1.ocplanet.cloud

# --- Local testing without a real OCP account ---
# 1. docker compose up -d minio  (or: docker run -p 9000:9000 -p 9001:9001
#    -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin
#    minio/minio server /data --console-address ":9001")
# 2. Open http://localhost:9001, log in with minioadmin/minioadmin.
# 3. Create a bucket (any name) and an Access Key under Access Keys.
# 4. Uncomment and fill in below (comment the OCP_* block above instead):
# OCP_REGION=us-east-1
# OCP_ACCESS_KEY_ID=<access key from step 3>
# OCP_SECRET_ACCESS_KEY=<secret key from step 3>
# OCP_BUCKET=<bucket name from step 3>
# OCP_PUBLIC_URL=http://localhost:9000/<bucket name>
# OCP_ENDPOINT=http://localhost:9000

# Redis — job queue for the async music-archive export (see backend/src/music-export).
# 6380 matches docker-compose's REDIS_EXTERNAL_PORT default (6379 is often
# already taken by a local Redis) — use 6379 if you run Redis yourself.
REDIS_HOST=localhost
REDIS_PORT=6380

# SMS one-time codes: dev | twilio | turbosms
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
