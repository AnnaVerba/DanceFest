PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=Dance-Fest-Local

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

FRONTEND_URL=http://localhost:5173

# First admin, seeded on boot if no user with this phone exists
ADMIN_PHONE=
ADMIN_PASSWORD=

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin

# OneCloudPlanet (OCP) S3-compatible Object Storage — see console.ocplanet.cloud
# Used for competition banners and entry tracks (see backend/src/tracks).
OCP_REGION=ua-central-1
OCP_ACCESS_KEY_ID=
OCP_SECRET_ACCESS_KEY=
OCP_BUCKET=project-bucket-dance-fest
OCP_PUBLIC_URL=
OCP_ENDPOINT=https://s3.ua-central-1.ocplanet.cloud

# Redis — job queue for the async music-archive export (see backend/src/music-export).
# 6380 matches docker-compose's REDIS_EXTERNAL_PORT default (6379 is often
# already taken by a local Redis) — use 6379 if you run Redis yourself.
REDIS_HOST=localhost
REDIS_PORT=6380

# SMS one-time codes: dev | twilio | turbosms
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
