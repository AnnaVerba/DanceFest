PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=Dance-Fest-Local

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400

# Окремий секрет для refresh-токена — навмисно інший, щоб access- і
# refresh-токени не можна було підробити одним і тим самим ключем.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Куди веде посилання із запрошення (заглушка листа логує саме цей URL)
FRONTEND_URL=http://localhost:5173

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin
