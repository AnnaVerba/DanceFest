# Production image for the NestJS API.
# node:22-slim (Debian), not alpine: bcrypt ships prebuilt glibc binaries only.
FROM node:22-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production

# The whole build stage on purpose: migrations are TypeScript and run through
# sequelize-cli + ts-node (dev dependencies) on every container start.
COPY --from=build /app ./

EXPOSE 4000

CMD ["sh", "-c", "npm run migrate && node dist/main"]
