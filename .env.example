
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=Dance-Fest-Local

DB_EXTERNAL_PORT=5433
REDIS_EXTERNAL_PORT=6380

# MinIO — free local stand-in for OneCloudPlanet, same S3 API. Console at
# http://localhost:9001 (login below). See backend/.env.example for how to
# point the app at it instead of real OCP.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_EXTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_SECRET=dev-access-secret-change-me
JWT_EXPIRES_IN_SECONDS=86400
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin

# OneCloudPlanet (OCP) S3-compatible Object Storage — see console.ocplanet.cloud
OCP_REGION=us-east-1
OCP_ACCESS_KEY_ID=
OCP_SECRET_ACCESS_KEY=
OCP_BUCKET=
OCP_PUBLIC_URL=
OCP_ENDPOINT=https://s3.ua-central-1.ocplanet.cloud
