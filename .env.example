# Змінні для docker compose. Скопіюй у .env поряд із docker-compose.yml:
#   cp .env.example .env
# Без .env compose візьме значення за замовчуванням, вказані нижче в дужках.

# Облікові дані Postgres усередині контейнера (створюються при першому старті).
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=Dance-Fest-Local

# На якому порту хоста слухати Postgres. Не 5432, бо той зазвичай уже
# зайнятий локальним Postgres або іншим контейнером.
DB_EXTERNAL_PORT=5433

# Навмисно різні секрети, щоб access- і refresh-токени не можна було
# підробити одним ключем.
JWT_SECRET=dev-access-secret-change-me
JWT_EXPIRES_IN_SECONDS=86400
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=CompAdmin
